[Unit]
Description=Cloudflare tunnel for the camera service
After=network-online.target habitacion-cam.service
Wants=network-online.target

[Service]
User=cloudflared
Group=cloudflared
EnvironmentFile=/etc/habitacion-cam/cloudflared.env
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel run
Restart=always
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
